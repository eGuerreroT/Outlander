@inherits LayoutComponentBase

@inject IJSRuntime JS

<OutlanderLayout>
    <NavMenu>
        <OutlanderNavMenu @bind-MobileMenuOpen="mobileMenuOpen"
                          @bind-NavMenuCollapsed="navMenuCollapsed"
                          ShowNavMenuToggle="false"
                          BrandText="Outlander Blazor"
                          Groups="NavMenuGroups"
                          FooterItems="NavMenuFooterItems"
                          BrandContent="@BrandIcon" />
    </NavMenu>

    <TopMenu>
        <OutlanderTopMenu @bind-MobileMenuOpen="mobileMenuOpen"
                          @bind-NavMenuCollapsed="navMenuCollapsed"
                          ShowNavMenuToggle="true"
                          ShowThemeSelector="true"
                          CollapseActionsToOffcanvasOnMobile="true"
                          IncludeLeftContentInMobileOffcanvas="false">

            <RightContent>
                <button class="outlander-icon-btn btn outlander-btn-default"
                        title="GitHub"
                        @onclick="OpenGitHub">
                    <span class="d-inline-flex align-items-center gap-2">
                        <i class="bi bi-github"></i>
                        <span>GitHub</span>
                    </span>

                </button>

                <button class="outlander-icon-btn btn outlander-btn-default"
                        title="Nuget"
                        @onclick="OpenNuget">
                    <span class="d-inline-flex align-items-center gap-2">
                        <img class="ico-nuget" src="https://avatars.githubusercontent.com/u/968310?s=48&v=4" height="16" />
                        <span>Nuget</span>
                    </span>

                </button>
            </RightContent>
        </OutlanderTopMenu>
    </TopMenu>

    <Body>
        @Body
    </Body>

    <Footer>
        <span>
            © 2026 My Outlander Company
        </span>
        <span>
            <img src="https://img.shields.io/badge/TFMs-net8.0%20%7C%20net9.0%20%7C%20net10.0-blue" />
            <img src="https://img.shields.io/nuget/v/Outlander.Blazor.svg" />
            <img src="https://img.shields.io/nuget/dt/Outlander.Blazor.svg" />
            <img src="https://img.shields.io/github/license/eGuerreroT/Outlander.svg" />
        </span>
    </Footer>
</OutlanderLayout>

<div id="blazor-error-ui" class="bg-danger-subtle border border-danger-subtle text-danger-emphasis" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

