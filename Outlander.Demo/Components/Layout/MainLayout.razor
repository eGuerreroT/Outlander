@inherits LayoutComponentBase

<OutlanderLayout>
    <NavMenu>
        <OutlanderNavMenu @bind-MobileMenuOpen="mobileMenuOpen"
                          @bind-NavMenuCollapsed="navMenuCollapsed"
                          ShowNavMenuToggle="false"
                          BrandText="Outlander Blazor"
                          Groups="NavMenuGroups"
                          FooterItems="NavMenuFooterItems" />
    </NavMenu>

    <TopMenu>
        <OutlanderTopMenu @bind-MobileMenuOpen="mobileMenuOpen"
                          @bind-NavMenuCollapsed="navMenuCollapsed"
                          ShowNavMenuToggle="true"
                          ShowThemeSelector="true"
                          CollapseActionsToOffcanvasOnMobile="true"
                          IncludeLeftContentInMobileOffcanvas="false"
                          ActionItems="TopActions" />
    </TopMenu>

    <Body>
        @Body
    </Body>

    <Footer>
        <span>
            © 2026 My Outlander Company
        </span>
        <span>
            Outlander.Blazor v1.0.1
        </span>
    </Footer>
</OutlanderLayout>

<div id="blazor-error-ui" class="bg-danger-subtle border border-danger-subtle text-danger-emphasis" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool mobileMenuOpen;
    private bool navMenuCollapsed;

    private List<OutlanderTopMenuActionItem> TopActions = [];
    private List<OutlanderNavMenuMenuGroup> NavMenuGroups = [];
    private List<OutlanderNavMenuItem> NavMenuFooterItems = [];

    private Task OpenDocs() => Task.CompletedTask;
    private Task ShowNotifications() => Task.CompletedTask;
    private Task OpenProfile() => Task.CompletedTask;

    protected override void OnInitialized()
    {
        TopActions =
        [
            new OutlanderTopMenuActionItem
            {
                Title = "Docs",
                Icon = "bi-journal-text",
                OnClick = EventCallback.Factory.Create(this, OpenDocs)
            },
            new OutlanderTopMenuActionItem
            {
                Title = "Notificaciones",
                Icon = "bi-bell",
                BadgeText = "3",
                OnClick = EventCallback.Factory.Create(this, ShowNotifications)
            },
            new OutlanderTopMenuActionItem
            {
                Title = "Usuario",
                Icon = "bi-person-circle",
                OnClick = EventCallback.Factory.Create(this, OpenProfile),
                KeepVisibleOnMobile = true
            }
        ];

        NavMenuGroups =
        [
            new OutlanderNavMenuMenuGroup
            {
                Title = "Principal",
                Items =
                [
                    new OutlanderNavMenuItem
                    {
                        Text = "Dashboard",
                        Icon = "bi-grid",
                        Url = "#",
                        Tooltip = "Dashboard"
                    }
                ]
            },
            new OutlanderNavMenuMenuGroup
            {
                Title = "Components",
                Items =
                [
                    new OutlanderNavMenuItem
                    {
                        Text = "Grid",
                        Icon = "bi-grid-3x3-gap",
                        Tooltip = "Grid",
                        Children =
                        [
                            new OutlanderNavMenuItem
                            {
                                Text = "Custom Columns",
                                Icon = "bi-table",
                                Url = "/",
                                Tooltip = "Custom Columns",
                            },
                            new OutlanderNavMenuItem
                            {
                                Text = "Automatic Columns",
                                Icon = "bi-grid-3x2",
                                Url = "/AutomaticColumns",
                                Tooltip = "Automatic Columns"
                            }
                        ]
                    },
                    new OutlanderNavMenuItem
                    {
                        Text = "Layout",
                        Icon = "bi-window-stack",
                        Tooltip = "Layout",
                        Children =
                        [
                            new OutlanderNavMenuItem
                            {
                                Text = "Layout Shell",
                                Icon = "bi-layout-sidebar-inset",
                                Url = "/layout-shell",
                                Tooltip = "Layout Shell"
                            }
                        ]
                    },
                    new OutlanderNavMenuItem
                    {
                        Text = "Navigation",
                        Icon = "bi-compass",
                        Tooltip = "Navigation",
                        Children =
                        [
                            new OutlanderNavMenuItem
                            {
                                Text = "NavMenu",
                                Icon = "bi-list",
                                Url = "/navmenu-demo",
                                Tooltip = "NavMenu"
                            },
                            new OutlanderNavMenuItem
                            {
                                Text = "TopMenu",
                                Icon = "bi-menu-button-wide",
                                Url = "/topmenu-demo",
                                Tooltip = "TopMenu"
                            }
                        ]
                    }
                ]
            },
            new OutlanderNavMenuMenuGroup
            {
                Title = "Theming",
                Items =
                [
                    new OutlanderNavMenuItem
                    {
                        Text = "Theme Selector",
                        Icon = "bi-circle-half",
                        Tooltip = "Theme",
                        Url = "/theme-selector-demo"
                    }
                ]
            }
        ];

        NavMenuFooterItems =
        [
            new OutlanderNavMenuItem
            {
                Text = "Configuración",
                Icon = "bi-gear",
                Url = "#",
                Tooltip = "Configuración"
            }
        ];
    }
}
