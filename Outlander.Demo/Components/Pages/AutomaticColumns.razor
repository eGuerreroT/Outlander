@page "/AutomaticColumns"
@using Outlander.Demo.LanguageDefinitions
@using Outlander.Demo.Data
@using Microsoft.EntityFrameworkCore
@inject IJSRuntime JS
@inject DemoDbContext Db

<PageTitle>Automatic Columns</PageTitle>

<div class="ol-doc-page">

    <div class="row g-4 align-items-start">
        <div class="col-xl-8">
            <div class="mb-4">
                <div class="d-flex align-items-center gap-3 flex-wrap mb-3">
                    <h1 class="mb-0">OutlanderGrid</h1>
                    <span class="bg-body-tertiary btn outlander-btn-default btn-sm rounded-pill">Automatic Columns</span>
                </div>

                <p class="lead text-body-secondary mb-4">
                    Quick grid setup using field-based columns with minimal configuration.
                </p>

                <p class="mb-2">
                    This demo shows how to define <code>OutlanderGridDataColumn</code> entries by <code>FieldName</code>
                    and let the grid handle rendering, filtering, and paging with a clean setup.
                </p>
                <p class="mb-4">
                    Ideal for admin tables and internal tools where speed and maintainability are key.
                </p>

                <div class="row g-3">
                    <div class="col-sm-6 col-lg-3">
                        <div class="ol-region-pill">
                            <div class="ol-region-icon"><i class="bi bi-lightning-charge"></i></div>
                            <div>
                                <div class="fw-semibold">Fast Setup</div>
                                <small class="text-body-secondary">Field-based column declarations</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-lg-3">
                        <div class="ol-region-pill">
                            <div class="ol-region-icon"><i class="bi bi-funnel"></i></div>
                            <div>
                                <div class="fw-semibold">Filtering</div>
                                <small class="text-body-secondary">Built-in filter row support</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-lg-3">
                        <div class="ol-region-pill">
                            <div class="ol-region-icon"><i class="bi bi-columns-gap"></i></div>
                            <div>
                                <div class="fw-semibold">Structured</div>
                                <small class="text-body-secondary">Consistent tabular layout</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-lg-3">
                        <div class="ol-region-pill">
                            <div class="ol-region-icon"><i class="bi bi-list-check"></i></div>
                            <div>
                                <div class="fw-semibold">Focused + Selected</div>
                                <small class="text-body-secondary">State binding ready</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card ol-side-card">
                <div class="card-body">
                    <h5 class="mb-3">Key Features</h5>
                    <ul class="list-unstyled mb-0 ol-feature-list">
                        <li><i class="bi bi-check-circle-fill"></i> Fast setup with FieldName-based columns</li>
                        <li><i class="bi bi-check-circle-fill"></i> Minimal boilerplate configuration</li>
                        <li><i class="bi bi-check-circle-fill"></i> Built-in filter row support</li>
                        <li><i class="bi bi-check-circle-fill"></i> Range filtering for numeric/date fields</li>
                        <li><i class="bi bi-check-circle-fill"></i> Focused row and selected items binding</li>
                        <li><i class="bi bi-check-circle-fill"></i> Automatic highlighted rendering fallback</li>
                        <li><i class="bi bi-check-circle-fill"></i> Built-in paging and summary footer</li>
                        <li><i class="bi bi-check-circle-fill"></i> Clean baseline for internal CRUD screens</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="border-0 card mt-4 shadow-none">
        <div class="bg-transparent border-0 card-header pb-0">
            <ul class="nav ol-doc-tabs" id="gridAutoTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link ol-doc-tab active"
                            id="preview-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#preview-tab-pane"
                            type="button"
                            role="tab"
                            aria-controls="preview-tab-pane"
                            aria-selected="true">
                        Preview
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link ol-doc-tab"
                            id="razor-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#razor-tab-pane"
                            type="button"
                            role="tab"
                            aria-controls="razor-tab-pane"
                            aria-selected="false">
                        Razor
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link ol-doc-tab"
                            id="csharp-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#csharp-tab-pane"
                            type="button"
                            role="tab"
                            aria-controls="csharp-tab-pane"
                            aria-selected="false">
                        C#
                    </button>
                </li>
            </ul>
        </div>

        <div class="outlander-border card-body rounded">
            <div class="tab-content" id="gridAutoTabsContent">

                <div class="tab-pane fade show active"
                     id="preview-tab-pane"
                     role="tabpanel"
                     aria-labelledby="preview-tab"
                     tabindex="0">

                    <div class="ol-tags-preview">
                        <div class="ol-tags-preview-toolbar">
                            <div class="fw-semibold">Grid with automatic columns</div>
                            <span class="bg-danger-subtle border border-danger-subtle text-danger-emphasis rounded-pill px-2 d-inline-flex gap-2 align-items-center">
                                <span class="badge-dot bg-success bg-gradient"></span>Interactive Preview
                            </span>
                        </div>

                        <div class="ol-tags-preview-body">
                            <OutlanderGrid TItem="ServerItem"
                                           Items="@ServersA"
                                           @bind-FocusedRow="@FocusedServerA"
                                           @bind-SelectedItems="@SelectedServersA"
                                           ShowFilterRow="true"
                                           PageSize="7"
                                           EmptyText="Servers not found.">

                                <Columns>

                                    <OutlanderGridDataColumn TItem="ServerItem"
                                                             FieldName="Name" />

                                    <OutlanderGridDataColumn TItem="ServerItem"
                                                             FieldName="Provider" />

                                    <OutlanderGridDataColumn TItem="ServerItem"
                                                             FieldName="Status" />

                                    <OutlanderGridDataColumn TItem="ServerItem"
                                                             FieldName="Ip" />

                                    <OutlanderGridDataColumn TItem="ServerItem"
                                                             FieldName="Cluster" />

                                    <OutlanderGridDataColumn TItem="ServerItem"
                                                             FieldName="OperatingSystem" />

                                    <OutlanderGridDataColumn TItem="ServerItem"
                                                             FieldName="IsNew" />

                                    <OutlanderGridDataColumn TItem="ServerItem"
                                                             FieldName="MemoryGb"
                                                             FilterMode="GridFilterMode.Range" />

                                    <OutlanderGridDataColumn TItem="ServerItem"
                                                             FieldName="CreatedAt"
                                                             FilterMode="GridFilterMode.Range" />
                                </Columns>
                            </OutlanderGrid>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade"
                     id="razor-tab-pane"
                     role="tabpanel"
                     aria-labelledby="razor-tab"
                     tabindex="0">

                    <div class="ol-code-card">
                        <div class="ol-code-card-body">
                            <button class="btn btn-sm ol-copy-btn @(copiedBlock == CodeBlockType.Razor ? "copied" : null)"
                                    @onclick="() => CopyCodeAsync(razorCode, CodeBlockType.Razor)">
                                <i class="bi @(copiedBlock == CodeBlockType.Razor ? "bi-check2" : "bi-copy") me-1"></i>
                                @(copiedBlock == CodeBlockType.Razor ? "Copied" : "Copy")
                            </button>

                            <CodeHighlighter Content="@razorCode"
                                             LanguageDefinition="@(new OutlanderRazorLanguageDefinition())" />
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade"
                     id="csharp-tab-pane"
                     role="tabpanel"
                     aria-labelledby="csharp-tab"
                     tabindex="0">

                    <div class="ol-code-card">
                        <div class="ol-code-card-body">
                            <button class="btn btn-sm ol-copy-btn @(copiedBlock == CodeBlockType.CSharp ? "copied" : null)"
                                    @onclick="() => CopyCodeAsync(csharpCode, CodeBlockType.CSharp)">
                                <i class="bi @(copiedBlock == CodeBlockType.CSharp ? "bi-check2" : "bi-copy") me-1"></i>
                                @(copiedBlock == CodeBlockType.CSharp ? "Copied" : "Copy")
                            </button>

                            <CodeHighlighter Content="@csharpCode"
                                             LanguageDefinition="@(new OutlanderCSharpLanguageDefinition())" />
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="mb-3 fw-bold">Grid Layout</h5>
                    <div class="ol-anatomy">
                        <div class="ol-anatomy-top">Grid Container</div>
                        <div class="ol-anatomy-nav">FieldName Columns + Optional Filter Row</div>
                        <div class="ol-anatomy-middle ol-anatomy-body">Automatic Cell Rendering + Selection/Focus State</div>
                        <div class="ol-anatomy-footer">Summary + Pagination</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="mb-3 fw-bold">Main Elements</h5>

                    <div class="table-responsive ol-rounded-table">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col" class="bg-secondary-subtle">Element</th>
                                    <th scope="col" class="bg-secondary-subtle">Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span class="fw-semibold text-primary">FieldName Columns</span></td>
                                    <td>Maps each column directly to a model property name.</td>
                                </tr>
                                <tr>
                                    <td><span class="fw-semibold text-primary">Auto Filter Editors</span></td>
                                    <td>Generates built-in filter controls when filtering is enabled.</td>
                                </tr>
                                <tr>
                                    <td><span class="fw-semibold">Range Filters</span></td>
                                    <td>Uses <code>GridFilterMode.Range</code> for <code>MemoryGb</code> and <code>CreatedAt</code>.</td>
                                </tr>
                                <tr>
                                    <td><span class="fw-semibold text-success">FocusedRow Binding</span></td>
                                    <td>Keeps current row context synchronized with page state.</td>
                                </tr>
                                <tr>
                                    <td><span class="fw-semibold text-success">SelectedItems Binding</span></td>
                                    <td>Tracks selected records for downstream bulk operations.</td>
                                </tr>
                                <tr>
                                    <td><span class="fw-semibold">EmptyText</span></td>
                                    <td>Displays a full-width fallback row when no records match.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-warning mt-4">
        <div class="d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-info-circle text-warning"></i>
            <h5 class="mb-0">Notes</h5>
        </div>

        <ul class="mb-0">
            <li><strong>FieldName</strong> property lookup is reflection-based and case-insensitive.</li>
            <li>Automatic columns are ideal as a baseline; move to templates only when custom UX is needed.</li>
            <li>Use <strong>GridFilterMode.Range</strong> on numeric/date columns for clearer filtering behavior.</li>
            <li>Use <strong>@@bind-FocusedRow</strong> and <strong>@@bind-SelectedItems</strong> to externalize grid state.</li>
            <li>Keep model property names stable—they are the contract for automatic column definitions.</li>
        </ul>
    </div>

</div>

@code {
    private CodeBlockType? copiedBlock;

    private enum CodeBlockType
    {
        Razor,
        CSharp
    }

    public class ServerItem
    {
        public string Name { get; set; } = string.Empty;
        public string Provider { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public string Ip { get; set; } = string.Empty;
        public string Cluster { get; set; } = string.Empty;
        public string OperatingSystem { get; set; } = string.Empty;
        public string BootStrapIcon { get; set; } = string.Empty;
        public string Abreviature { get; set; } = string.Empty;
        public bool IsNew { get; set; }
        public bool Selected { get; set; }
        public DateTime CreatedAt { get; set; }
        public decimal MemoryGb { get; set; }
    }

    private List<ServerItem> ServersA = new();

    private ServerItem? FocusedServerA { get; set; }
    private IList<ServerItem> SelectedServersA { get; set; } = new List<ServerItem>();

    protected override async Task OnInitializedAsync()
    {
        ServersA = await Db.Servers
            .AsNoTracking()
            .OrderBy(x => x.Name)
            .Select(x => new ServerItem
            {
                Name = x.Name,
                Provider = x.Provider,
                Status = x.Status,
                Ip = x.Ip,
                Cluster = x.Cluster,
                OperatingSystem = x.OperatingSystem,
                CreatedAt = x.CreatedAt,
                MemoryGb = x.MemoryGb
            })
            .ToListAsync();
    }

    private async Task CopyCodeAsync(string text, CodeBlockType blockType)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);

        copiedBlock = blockType;
        StateHasChanged();

        await Task.Delay(2000);

        if (copiedBlock == blockType)
        {
            copiedBlock = null;
            StateHasChanged();
        }
    }

    private string razorCode = """
        <OutlanderGrid TItem="ServerItem"
                       Items="@ServersA"
                       @bind-FocusedRow="@FocusedServerA"
                       @bind-SelectedItems="@SelectedServersA"
                       ShowFilterRow="true"
                       PageSize="7"
                       EmptyText="Servers not found.">
            <Columns>
                <OutlanderGridDataColumn TItem="ServerItem" FieldName="Name" />
                <OutlanderGridDataColumn TItem="ServerItem" FieldName="Provider" />
                <OutlanderGridDataColumn TItem="ServerItem" FieldName="Status" />
                <OutlanderGridDataColumn TItem="ServerItem" FieldName="Ip" />
                <OutlanderGridDataColumn TItem="ServerItem" FieldName="Cluster" />
                <OutlanderGridDataColumn TItem="ServerItem" FieldName="OperatingSystem" />
                <OutlanderGridDataColumn TItem="ServerItem" FieldName="IsNew" />
                <OutlanderGridDataColumn TItem="ServerItem" FieldName="MemoryGb" FilterMode="GridFilterMode.Range" />
                <OutlanderGridDataColumn TItem="ServerItem" FieldName="CreatedAt" FilterMode="GridFilterMode.Range" />
            </Columns>
        </OutlanderGrid>
    """;

    private string csharpCode = """
using Microsoft.EntityFrameworkCore;
using Outlander.Demo.Data;

public class ServerItem
{
    public string Name { get; set; } = string.Empty;
    public string Provider { get; set; } = string.Empty;
    public string Status { get; set; } = string.Empty;
    public string Ip { get; set; } = string.Empty;
    public string Cluster { get; set; } = string.Empty;
    public string OperatingSystem { get; set; } = string.Empty;
    public bool IsNew { get; set; }
    public DateTime CreatedAt { get; set; }
    public decimal MemoryGb { get; set; }
}

private List<ServerItem> ServersA = new();

protected override async Task OnInitializedAsync()
{
    ServersA = await Db.Servers
        .AsNoTracking()
        .OrderBy(x => x.Name)
        .Select(x => new ServerItem
        {
            Name = x.Name,
            Provider = x.Provider,
            Status = x.Status,
            Ip = x.Ip,
            Cluster = x.Cluster,
            OperatingSystem = x.OperatingSystem,
            CreatedAt = x.CreatedAt,
            MemoryGb = x.MemoryGb
        })
        .ToListAsync();
}
""";
}