@page "/"
@using Outlander.Demo.LanguageDefinitions
@using Outlander.Demo.Data
@using Microsoft.EntityFrameworkCore
@inject IJSRuntime JS
@inject DemoDbContext Db

<PageTitle>Home</PageTitle>

<div class="ol-doc-page">

    <div class="row g-4 align-items-start">
        <div class="col-xl-8">
            <div class="mb-4">
                <div class="d-flex align-items-center gap-3 flex-wrap mb-3">
                    <h1 class="mb-0">OutlanderGrid</h1>
                    <span class="bg-body-tertiary btn outlander-btn-default btn-sm rounded-pill">Custom Columns</span>
                </div>

                <p class="lead text-body-secondary mb-4">
                    Advanced data grid demo with templates, filtering, sorting, search, export and selection.
                </p>

                <p class="mb-2">
                    This page demonstrates a fully customized <code>OutlanderGrid</code> using
                    custom cell templates, custom filter templates, toolbar actions, and export options.
                </p>
                <p class="mb-4">
                    Use it as a reference for production-ready business tables in Blazor.
                </p>

                <div class="row g-3">
                    <div class="col-sm-6 col-lg-3">
                        <div class="ol-region-pill">
                            <div class="ol-region-icon"><i class="bi bi-funnel"></i></div>
                            <div>
                                <div class="fw-semibold">Filtering</div>
                                <small class="text-body-secondary">Column filter row + custom templates</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-lg-3">
                        <div class="ol-region-pill">
                            <div class="ol-region-icon"><i class="bi bi-sort-down"></i></div>
                            <div>
                                <div class="fw-semibold">Sorting</div>
                                <small class="text-body-secondary">Single and multi-column sort support</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-lg-3">
                        <div class="ol-region-pill">
                            <div class="ol-region-icon"><i class="bi bi-search"></i></div>
                            <div>
                                <div class="fw-semibold">Search</div>
                                <small class="text-body-secondary">Global search across columns</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-lg-3">
                        <div class="ol-region-pill">
                            <div class="ol-region-icon"><i class="bi bi-download"></i></div>
                            <div>
                                <div class="fw-semibold">Export</div>
                                <small class="text-body-secondary">Excel, PDF and print export</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card ol-side-card">
                <div class="card-body">
                    <h5 class="mb-3">Key Features</h5>
                    <ul class="list-unstyled mb-0 ol-feature-list">
                        <li><i class="bi bi-check-circle-fill"></i> Custom cell and filter templates per column</li>
                        <li><i class="bi bi-check-circle-fill"></i> Global search with configurable parse mode</li>
                        <li><i class="bi bi-check-circle-fill"></i> Display-based sorting and filtering selectors</li>
                        <li><i class="bi bi-check-circle-fill"></i> Row selection (row/page/processed scope)</li>
                        <li><i class="bi bi-check-circle-fill"></i> Focused row and optional hot-track behavior</li>
                        <li><i class="bi bi-check-circle-fill"></i> Export dropdown (Excel / PDF / Print)</li>
                        <li><i class="bi bi-check-circle-fill"></i> Column chooser with visibility control</li>
                        <li><i class="bi bi-check-circle-fill"></i> Paging summary + page-size selector</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="border-0 card mt-4 shadow-none">
        <div class="bg-transparent border-0 card-header pb-0">
            <ul class="nav ol-doc-tabs" id="gridCustomTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link ol-doc-tab active"
                            id="preview-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#preview-tab-pane"
                            type="button"
                            role="tab"
                            aria-controls="preview-tab-pane"
                            aria-selected="true">
                        Preview
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link ol-doc-tab"
                            id="razor-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#razor-tab-pane"
                            type="button"
                            role="tab"
                            aria-controls="razor-tab-pane"
                            aria-selected="false">
                        Razor
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link ol-doc-tab"
                            id="csharp-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#csharp-tab-pane"
                            type="button"
                            role="tab"
                            aria-controls="csharp-tab-pane"
                            aria-selected="false">
                        C#
                    </button>
                </li>
            </ul>
        </div>

        <div class="outlander-border card-body rounded">
            <div class="tab-content" id="gridCustomTabsContent">

                <div class="tab-pane fade show active"
                     id="preview-tab-pane"
                     role="tabpanel"
                     aria-labelledby="preview-tab"
                     tabindex="0">

                    <div class="ol-tags-preview">
                        <div class="ol-tags-preview-toolbar">
                            <div class="fw-semibold">Grid with custom columns</div>
                            <span class="bg-danger-subtle border border-danger-subtle text-danger-emphasis rounded-pill px-2 d-inline-flex gap-2 align-items-center">
                                <span class="badge-dot bg-success bg-gradient"></span>Interactive Preview
                            </span>
                        </div>

                        <div class="ol-tags-preview-body">
                            <OutlanderGrid TItem="ServerItem"
                                           Items="@ServersB"
                                           RowClick="OnRowClick"
                                           RowDoubleClick="OnRowDoubleClick"
                                           AllowSort="true"
                                           AllowHotTrackRow="true"
                                           AllowFocusedRow="true"
                                           @bind-FocusedRow="@FocusedServerB"
                                           @bind-SelectedItems="@SelectedServersB"
                                           ShowSearchBox="true"
                                           SearchBoxNullText="Search in all columns..."
                                           SearchBoxText=""
                                           ShowExportButtons="true"
                                           ExcelExportMode="OutlanderGridExportMode.Data"
                                           PdfExportMode="OutlanderGridExportMode.Data"
                                           PrintExportMode="OutlanderGridExportMode.Data"
                                           ExportFileName="Servers"
                                           ExportTitle="Servers List"
                                           SearchBoxParseMode="GridSearchTextParseMode.GroupWordsByAnd"
                                           PageSize="@PageSize"
                                           PageSizeChanged="OnPageSizeChanged"
                                           ShowPageSizeSelector="true"
                                           ShowColumnChooser="true"
                                           ShowFilterRow="true"
                                           EmptyText="No Records.">
                                <ToolbarTemplate>
                                    <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
                                        <button class="btn btn-primary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#importServersModal"
                                                disabled="@(SelectedServersB.Count == 0)">
                                            <i class="bi bi-download me-2"></i>
                                            <span>Import @SelectedServersB.Count Selected</span>
                                        </button>
                                    </div>
                                </ToolbarTemplate>
                                <Columns>
                                    <OutlanderGridSelectionColumn TItem="ServerItem"
                                                                  Width="48px"
                                                                  AllowSelectAllItems="true" />

                                    <OutlanderGridDataColumn TItem="ServerItem"
                                                             FieldName="Name"
                                                             Caption="Name"
                                                             AllowFilter="true"
                                                             AllowSort="true"
                                                             SortMode="GridColumnSortMode.DisplayText"
                                                             SortOrder="GridColumnSortOrder.Ascending"
                                                             SortIndex="1"
                                                             SortTextSelector="item => item.Name"
                                                             FilterTextSelector="item => item.Name">
                                        <FilterTemplate Context="filter">
                                            <input class="form-control form-control-sm"
                                                   placeholder="Filter by Name..."
                                                   value="@filter.Value"
                                                   @oninput="e => filter.SetValue(e.Value?.ToString())" />
                                        </FilterTemplate>
                                        <CellTemplate Context="cell">
                                            <div class="name-cell">
                                                @cell.Highlight(cell.Item.Name)
                                                @if (cell.Item.IsNew)
                                                {
                                                    <span class="bg-danger bg-opacity-10 text-danger border border-danger-subtle px-2 py-1 small rounded-pill ms-2">NUEVO</span>
                                                }
                                            </div>
                                        </CellTemplate>
                                    </OutlanderGridDataColumn>

                                    <OutlanderGridDataColumn TItem="ServerItem"
                                                             FieldName="Provider"
                                                             Caption="Provider"
                                                             AllowFilter="true"
                                                             AllowSort="true"
                                                             SortMode="GridColumnSortMode.DisplayText"
                                                             SortTextSelector="item => item.Provider"
                                                             FilterTextSelector="item => item.Provider">
                                        <FilterTemplate Context="filter">
                                            <select class="form-select form-select-sm"
                                                    value="@filter.Value"
                                                    @onchange="e => filter.SetValue(e.Value?.ToString())">
                                                <option value="">Todos</option>
                                                <option value="VMware">VMware</option>
                                                <option value="Alibaba">Alibaba</option>
                                            </select>
                                        </FilterTemplate>
                                        <CellTemplate Context="cell">
                                            <div class="provider-cell">
                                                <span class="provider-mini @cell.Item.BootStrapIcon">@cell.Item.Abreviature</span>
                                                <span>@cell.Highlight(cell.Item.Provider)</span>
                                            </div>
                                        </CellTemplate>
                                    </OutlanderGridDataColumn>

                                    <OutlanderGridDataColumn TItem="ServerItem"
                                                             FieldName="Status"
                                                             Caption="Status"
                                                             AllowFilter="true"
                                                             AllowSort="true"
                                                             SortMode="GridColumnSortMode.DisplayText"
                                                             SortTextSelector="item => item.Status"
                                                             FilterTextSelector="item => item.Status">
                                        <FilterTemplate Context="filter">
                                            <select class="form-select form-select-sm"
                                                    value="@filter.Value"
                                                    @onchange="e => filter.SetValue(e.Value?.ToString())">
                                                <option value="">Todos</option>
                                                <option value="Running">Running</option>
                                                <option value="Powered Off">Powered Off</option>
                                            </select>
                                        </FilterTemplate>
                                        <CellTemplate Context="cell">
                                            <div class="status-cell">
                                                <span class="status-dot @(cell.Item.Status == "Running" ? "status-green" : "status-orange")"></span>
                                                <span>@cell.Highlight(cell.Item.Status)</span>
                                            </div>
                                        </CellTemplate>
                                    </OutlanderGridDataColumn>

                                    <OutlanderGridDataColumn TItem="ServerItem"
                                                             FieldName="Ip"
                                                             Caption="IP"
                                                             AllowFilter="true"
                                                             AllowSort="true"
                                                             FilterTextSelector="item => item.Ip">
                                        <FilterTemplate Context="filter">
                                            <input class="form-control form-control-sm"
                                                   placeholder="IP..."
                                                   value="@filter.Value"
                                                   @oninput="e => filter.SetValue(e.Value?.ToString())" />
                                        </FilterTemplate>
                                    </OutlanderGridDataColumn>

                                    <OutlanderGridDataColumn TItem="ServerItem"
                                                             FieldName="Cluster"
                                                             Caption="Cluster / Resource"
                                                             AllowFilter="true"
                                                             AllowSort="true"
                                                             SortMode="GridColumnSortMode.DisplayText"
                                                             SortTextSelector="item => item.Cluster"
                                                             FilterTextSelector="item => item.Cluster">
                                        <FilterTemplate Context="filter">
                                            <input class="form-control form-control-sm"
                                                   placeholder="Cluster..."
                                                   value="@filter.Value"
                                                   @oninput="e => filter.SetValue(e.Value?.ToString())" />
                                        </FilterTemplate>
                                    </OutlanderGridDataColumn>

                                    <OutlanderGridDataColumn TItem="ServerItem"
                                                             FieldName="OperatingSystem"
                                                             Caption="Operating System"
                                                             AllowFilter="true"
                                                             AllowSort="true"
                                                             SortMode="GridColumnSortMode.DisplayText"
                                                             FilterMode="GridFilterMode.Range"
                                                             SortTextSelector='item => $"{item.Provider}-({item.OperatingSystem})"'
                                                             FilterTextSelector='item => $"{item.Provider}-({item.OperatingSystem})"'>
                                        <CellTemplate Context="cell">
                                            <div class="status-cell">
                                                <span class="fw-bold">@cell.Highlight(cell.Item.Provider + "-")</span>
                                                <span>@cell.Highlight(cell.Item.OperatingSystem)</span>
                                            </div>
                                        </CellTemplate>
                                    </OutlanderGridDataColumn>

                                    <OutlanderGridDataColumn TItem="ServerItem"
                                                             FieldName="_registered"
                                                             Caption="Registered"
                                                             AllowSort="false"
                                                             FilterTextSelector='item => "No"'>
                                        <CellTemplate Context="cell">
                                            <span class="bg-danger bg-opacity-10 border border-danger-subtle fw-normal px-2 py-1 rounded small text-danger">
                                                @cell.Highlight("No")
                                            </span>
                                        </CellTemplate>
                                    </OutlanderGridDataColumn>

                                    <OutlanderGridDataColumn TItem="ServerItem"
                                                             FieldName="_actions"
                                                             Caption="Action"
                                                             AllowFilter="false"
                                                             AllowSort="false"
                                                             AllowExport="false"
                                                             Width="90px">
                                        <CellTemplate Context="cell">
                                            <button class="btn btn-default btn-default-sm app-grid-export-ignore">
                                                <i class="bi bi-download"></i>
                                            </button>
                                        </CellTemplate>
                                    </OutlanderGridDataColumn>
                                </Columns>
                            </OutlanderGrid>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade"
                     id="razor-tab-pane"
                     role="tabpanel"
                     aria-labelledby="razor-tab"
                     tabindex="0">

                    <div class="ol-code-card">
                        <div class="ol-code-card-body">
                            <button class="btn btn-sm ol-copy-btn @(copiedBlock == CodeBlockType.Razor ? "copied" : null)"
                                    @onclick="() => CopyCodeAsync(razorCode, CodeBlockType.Razor)">
                                <i class="bi @(copiedBlock == CodeBlockType.Razor ? "bi-check2" : "bi-copy") me-1"></i>
                                @(copiedBlock == CodeBlockType.Razor ? "Copied" : "Copy")
                            </button>

                            <CodeHighlighter Content="@razorCode"
                                             LanguageDefinition="@(new OutlanderRazorLanguageDefinition())" />
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade"
                     id="csharp-tab-pane"
                     role="tabpanel"
                     aria-labelledby="csharp-tab"
                     tabindex="0">

                    <div class="ol-code-card">
                        <div class="ol-code-card-body">
                            <button class="btn btn-sm ol-copy-btn @(copiedBlock == CodeBlockType.CSharp ? "copied" : null)"
                                    @onclick="() => CopyCodeAsync(csharpCode, CodeBlockType.CSharp)">
                                <i class="bi @(copiedBlock == CodeBlockType.CSharp ? "bi-check2" : "bi-copy") me-1"></i>
                                @(copiedBlock == CodeBlockType.CSharp ? "Copied" : "Copy")
                            </button>

                            <CodeHighlighter Content="@csharpCode"
                                             LanguageDefinition="@(new OutlanderCSharpLanguageDefinition())" />
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="mb-3 fw-bold">Grid Layout</h5>
                    <div class="ol-anatomy">
                        <div class="ol-anatomy-top">Primary Toolbar (Page Size / Export / Custom Actions)</div>
                        <div class="ol-anatomy-nav">Secondary Toolbar (Search / Select Scope / Column Chooser)</div>

                        <div class="ol-anatomy-middle ol-anatomy-body">Grid Surface (Sortable Headers + Filters + Templated Cells)</div>
                        <div class="ol-anatomy-footer">Footer (Summary + Pagination)</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="mb-3 fw-bold">Main Elements</h5>

                    <div class="table-responsive ol-rounded-table">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col" class="bg-secondary-subtle">Element</th>
                                    <th scope="col" class="bg-secondary-subtle">Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span class="fw-semibold text-primary">ToolbarTemplate</span></td>
                                    <td>Injects custom actions such as import/export workflows.</td>
                                </tr>
                                <tr>
                                    <td><span class="fw-semibold text-primary">Selection System</span></td>
                                    <td>Supports row, current page, and processed-items selection scopes.</td>
                                </tr>
                                <tr>
                                    <td><span class="fw-semibold">Header Sorting</span></td>
                                    <td>Sortable headers with visual sort-state indicator.</td>
                                </tr>
                                <tr>
                                    <td><span class="fw-semibold text-success">Filter Row</span></td>
                                    <td>Uses custom FilterTemplate or automatic filter UI per column.</td>
                                </tr>
                                <tr>
                                    <td><span class="fw-semibold text-success">CellTemplate</span></td>
                                    <td>Custom rendering for badges, icons, statuses, and command cells.</td>
                                </tr>
                                <tr>
                                    <td><span class="fw-semibold text-success">Export Menu</span></td>
                                    <td>Per-format export actions with configurable visibility and mode.</td>
                                </tr>
                                <tr>
                                    <td><span class="fw-semibold">Column Chooser</span></td>
                                    <td>Toggles column visibility while preserving at least one visible column.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-warning mt-4">
        <div class="d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-info-circle text-warning"></i>
            <h5 class="mb-0">Notes</h5>
        </div>

        <ul class="mb-0">
            <li>Use <strong>@@bind-SelectedItems</strong> and <strong>@@bind-FocusedRow</strong> for full state synchronization.</li>
            <li>Set <strong>AllowExport="false"</strong> on utility/action columns to keep exported files clean.</li>
            <li>Use <strong>SortTextSelector</strong> / <strong>FilterTextSelector</strong> when rendered text differs from the raw field value.</li>
            <li><strong>ShowFilterRow</strong> renders filter editors only for visible columns that allow filtering.</li>
            <li>Search behavior is controlled by <strong>SearchBoxParseMode</strong> (important for multi-word queries).</li>
            <li>The grid auto-adjusts current page when total pages change after filtering/searching.</li>
        </ul>
    </div>
</div>

@code {
    private CodeBlockType? copiedBlock;

    private enum CodeBlockType
    {
        Razor,
        CSharp
    }

    public class ServerItem
    {
        public string Name { get; set; } = string.Empty;
        public string Provider { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public string Ip { get; set; } = string.Empty;
        public string Cluster { get; set; } = string.Empty;
        public string OperatingSystem { get; set; } = string.Empty;
        public string BootStrapIcon { get; set; } = string.Empty;
        public string Abreviature { get; set; } = string.Empty;
        public bool IsNew { get; set; }
        public bool Selected { get; set; }
        public DateTime CreatedAt { get; set; }
        public decimal MemoryGb { get; set; }
    }

    private List<ServerItem> ServersB = new();

    private ServerItem? FocusedServerA { get; set; }

    private ServerItem? FocusedServerB { get; set; }
    private IList<ServerItem> SelectedServersB { get; set; } = new List<ServerItem>();

    private int PageSize = 10;

    private Task OnPageSizeChanged(int value)
    {
        PageSize = value;
        return Task.CompletedTask;
    }

    private Task OnRowClick(ServerItem item)
    {
        Console.WriteLine($"Click en: {item.Name}");
        return Task.CompletedTask;
    }

    private Task OnRowDoubleClick(ServerItem item)
    {
        Console.WriteLine($"Double click en: {item.Name}");
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        ServersB = await Db.Servers
            .AsNoTracking()
            .OrderBy(x => x.Name)
            .Select(x => new ServerItem
            {
                Name = x.Name,
                Provider = x.Provider,
                Status = x.Status,
                Ip = x.Ip,
                Cluster = x.Cluster,
                OperatingSystem = x.OperatingSystem,
                BootStrapIcon = x.Provider == "VMware" ? "provider-badge-primary" : "provider-badge-orange",
                Abreviature = x.Provider == "VMware" ? "vm" : "a",
                IsNew = x.CreatedAt >= DateTime.Today.AddDays(-30),
                Selected = false,
                CreatedAt = x.CreatedAt,
                MemoryGb = x.MemoryGb
            })
            .ToListAsync();
    }

    private async Task CopyCodeAsync(string text, CodeBlockType blockType)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);

        copiedBlock = blockType;
        StateHasChanged();

        await Task.Delay(2000);

        if (copiedBlock == blockType)
        {
            copiedBlock = null;
            StateHasChanged();
        }
    }

    private string razorCode = """
        <OutlanderGrid TItem="ServerItem"
                       Items="@ServersB"
                       RowClick="OnRowClick"
                       RowDoubleClick="OnRowDoubleClick"
                       AllowSort="true"
                       AllowHotTrackRow="true"
                       AllowFocusedRow="true"
                       @bind-FocusedRow="@FocusedServerB"
                       @bind-SelectedItems="@SelectedServersB"
                       ShowSearchBox="true"
                       ShowExportButtons="true"
                       ShowFilterRow="true"
                       ShowColumnChooser="true"
                       PageSize="@PageSize"
                       PageSizeChanged="OnPageSizeChanged">
            <Columns>
                <!-- Custom columns -->
            </Columns>
        </OutlanderGrid>
    """;

    private string csharpCode = """
using Microsoft.EntityFrameworkCore;
using Outlander.Demo.Data;

public class ServerItem
{
    public string Name { get; set; } = string.Empty;
    public string Provider { get; set; } = string.Empty;
    public string Status { get; set; } = string.Empty;
    public string Ip { get; set; } = string.Empty;
    public string Cluster { get; set; } = string.Empty;
    public string OperatingSystem { get; set; } = string.Empty;
    public string BootStrapIcon { get; set; } = string.Empty;
    public string Abreviature { get; set; } = string.Empty;
    public bool IsNew { get; set; }
    public bool Selected { get; set; }
    public DateTime CreatedAt { get; set; }
    public decimal MemoryGb { get; set; }
}

private List<ServerItem> ServersB = new();

protected override async Task OnInitializedAsync()
{
    ServersB = await Db.Servers
        .AsNoTracking()
        .OrderBy(x => x.Name)
        .Select(x => new ServerItem
        {
            Name = x.Name,
            Provider = x.Provider,
            Status = x.Status,
            Ip = x.Ip,
            Cluster = x.Cluster,
            OperatingSystem = x.OperatingSystem,
            BootStrapIcon = x.Provider == "VMware" ? "provider-badge-primary" : "provider-badge-orange",
            Abreviature = x.Provider == "VMware" ? "vm" : "a",
            IsNew = x.CreatedAt >= DateTime.Today.AddDays(-30),
            Selected = false,
            CreatedAt = x.CreatedAt,
            MemoryGb = x.MemoryGb
        })
        .ToListAsync();
}
""";
}