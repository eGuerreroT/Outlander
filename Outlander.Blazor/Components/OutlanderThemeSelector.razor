@namespace Outlander.Blazor.Components

@inherits Base.OutlanderComponentBase

<div class="btn-group @(initialized ? "" : "opacity-0")">
    <button type="button"
            class="btn outlander-btn-default dropdown-toggle"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            title="Change theme">
        <i class="bi @ThemeIcon"></i>
    </button>
    <ul class="dropdown-menu dropdown-menu-end">
        <li>
            <button class="dropdown-item d-flex align-items-center justify-content-between px-3 py-2 small @(CurrentTheme == "light" ? "active" : "")"
                    @onclick='() => ChangeTheme("light")'>
                <span class="d-inline-flex align-items-center gap-2">
                    <i class="bi bi-sun"></i>
                    <span>Claro</span>
                </span>
                @if (CurrentTheme == "light")
                {
                    <i class="bi bi-check2"></i>
                }
            </button>
        </li>
        <li>
            <button class="dropdown-item d-flex align-items-center justify-content-between px-3 py-2 small @(CurrentTheme == "dark" ? "active" : "")"
                    @onclick='() => ChangeTheme("dark")'>
                <span class="d-inline-flex align-items-center gap-2">
                    <i class="bi bi-moon-stars"></i>
                    <span>Oscuro</span>
                </span>
                @if (CurrentTheme == "dark")
                {
                    <i class="bi bi-check2"></i>
                }
            </button>
        </li>
        <li>
            <button class="dropdown-item d-flex align-items-center justify-content-between px-3 py-2 small @(CurrentTheme == "system" ? "active" : "")"
                    @onclick='() => ChangeTheme("system")'>
                <span class="d-inline-flex align-items-center gap-2">
                    <i class="bi bi-circle-half"></i>
                    <span>Sistema</span>
                </span>
                @if (CurrentTheme == "system")
                {
                    <i class="bi bi-check2"></i>
                }
            </button>
        </li>
    </ul>
</div>

@code {
    /// <summary>
    /// Gets or sets the current theme identifier.
    /// </summary>
    /// <remarks>
    /// Supported values are <c>light</c>, <c>dark</c>, and <c>system</c>.
    /// The selected value is stored in browser local storage and applied globally
    /// through the application theme configuration.
    /// </remarks>
    [Parameter]
    public string CurrentTheme { get; set; } = "system";

    /// <summary>
    /// Gets or sets the callback invoked when the selected theme changes.
    /// The callback receives the new theme identifier.
    /// </summary>
    /// <remarks>
    /// This value is controlled by the parent component.
    /// The component does not modify this value internally.
    /// Use two-way binding with <see cref="CurrentTheme"/> to keep the parent component
    /// synchronized with the selected theme.
    /// </remarks>
    [Parameter]
    public EventCallback<string> CurrentThemeChanged { get; set; }

    private bool initialized;
    private string ThemeIcon => CurrentTheme switch
    {
        "light" => "bi-sun",
        "dark" => "bi-moon-stars",
        _ => "bi-circle-half"
    };

    private DotNetObjectReference<OutlanderThemeSelector>? dotNetRef;

    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);

            _module = await JS.InvokeAsync<IJSObjectReference>("import", "/_content/Outlander.Blazor/Components/OutlanderThemeSelector.razor.js");

            await _module.InvokeVoidAsync("initTheme");

            var theme = await _module.InvokeAsync<string>("getTheme");
            
            if (theme is not ("light" or "dark" or "system"))
                theme = "system";
            
            if (CurrentThemeChanged.HasDelegate)
                await CurrentThemeChanged.InvokeAsync(theme);

            initialized = true;

            await InvokeAsync(StateHasChanged);
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task ChangeTheme(string theme)
    {
        if (_module is not null)
            await _module.InvokeVoidAsync("setTheme", theme);

        if (CurrentThemeChanged.HasDelegate)
            await CurrentThemeChanged.InvokeAsync(theme);
    }
}
